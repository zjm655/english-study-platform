# ====================================================================
# Docker 部署 app 服务专用配置：复制为 .env.app 后使用（cp .env.app.example .env.app）；
# 本文件入库为模板，.env.app 被 gitignore；本地开发仍用根 .env
# ====================================================================
NUXT_JWT_SECRET=""
NUXT_DB_HOST=""
NUXT_DB_PORT=""
NUXT_DB_USER=""
NUXT_DB_PASSWORD=""
NUXT_DB_DATABASE=""
# 迁移排序规则（NUXT_DB_COLLATION 迁移用）：MariaDB 10.11 不支持 0900_ai_ci，须用 utf8mb4_unicode_ci；
# MySQL 8 默认用 utf8mb4_0900_ai_ci；低版本(<8.0)/MariaDB 改 utf8mb4_unicode_ci/general_ci，migrate.ts 直读 .env 即生效
NUXT_DB_COLLATION=utf8mb4_unicode_ci
# Redis 连接（未配置/断连自动回落内存态，功能不中断）：多机部署时 host 填机器 A 内网 IP
NUXT_REDIS_HOST=""
NUXT_REDIS_PORT=""
# 与 docker/env/.env.redis 的 REDIS_PASSWORD 同值
NUXT_REDIS_PASSWORD=""
NUXT_PUBLIC_IS_OPEN_LOG=""
NUXT_IS_OPEN_LOG=""
# 文件日志保留天数（logs/ 超期 .log 启动时自动清理），留空默认 30
NUXT_LOG_RETENTION_DAYS=""
# 信任 X-Forwarded-For：nginx 已覆写 XFF 可保持 true；绕过 nginx 直连须改 false，否则可伪造 XFF 击穿 IP 级限流
NUXT_TRUST_PROXY=true
NUXT_OSS_REGION=""
NUXT_OSS_BUCKET=""
NUXT_OSS_ACCESS_KEY_ID=""
NUXT_OSS_ACCESS_KEY_SECRET=""
# 同 region 公网部署置 true 走内网免流量费
NUXT_OSS_USE_INTERNAL=""
NUXT_DEEPSEEK_MODEL = ""
NUXT_DEEPSEEK_API_KEY = ""
NUXT_DEEPSEEK_BASE_URL = "" #openai格式
NUXT_NLS_ACCESS_KEY_ID=""
NUXT_NLS_ACCESS_KEY_SECRET=""
# 智能语音交互服务网关地址（通用，自动就近分配）
NUXT_NLS_GATEWAY=""
NUXT_NLS_APP_KEY=""
# Edge TTS 代理（可选，公网 IP 被微软封锁时启用）：Worker 中转地址（见 content/cloudflare/tts-proxy-worker.js）形如 wss://域名/tts，留空直连微软
NUXT_TTS_PROXY_URL=""
# 校验密钥须与 Worker 的 Secret PROXY_KEY 完全一致
NUXT_TTS_PROXY_KEY=""
NUXT_AI_CONTENT_APP_ID=""
NUXT_AI_CONTENT_APP_SECRET=""
NUXT_AI_CONTENT_ACCESS_KEY_ID=""
NUXT_AI_CONTENT_ACCESS_KEY_SECRET=""
# 评测鉴权接口地址（段名 AI_CONTENT 驼峰拆分，勿写成 AICONTENT，否则注入无效恒用默认值）
NUXT_AI_CONTENT_AUTH_URL=""
NUXT_BSS_ACCESS_KEY_ID=""
NUXT_BSS_ACCESS_KEY_SECRET=""
# 启动期自举「全局唯一超级管理员」（可选）：ACCOUNT+PASSWORD 同时非空时启动自动建超管（role=2），任一为空则跳过；幂等，已存在同账号则跳过
# 账号 ≤20 字符须唯一；密码 ≥8 位为明文、启动时 bcrypt 加密入库——勿提交真实密码，建议首登后改密
NUXT_SUPER_ADMIN_ACCOUNT=""
NUXT_SUPER_ADMIN_PASSWORD=""
# 昵称/邮箱（选填，留空则默认账号当昵称/不设置）
NUXT_SUPER_ADMIN_NICKNAME=""
NUXT_SUPER_ADMIN_EMAIL=""
# 危险开关（仅 true/1 生效）：存在其它超管时置 true 降级旧超管、改立新超管（记审计日志），不显式开启只告警跳过；一次性动作，完成后建议改回空
NUXT_SUPER_ADMIN_FORCE_REPLACE=false
