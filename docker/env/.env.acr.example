# ====================================================================
# Docker 镜像构建/推送（阿里云 ACR）专用配置：复制为 .env.acr 后使用（cp .env.acr.example .env.acr）；
# 本文件入库为模板，.env.acr 被 gitignore（含账号密码等敏感信息，勿提交）；
# 用法一：本地构建推送 bash docker/scripts/build-push.sh（脚本自动 source 本文件）
# 用法二：服务器 docker compose --env-file docker/env/.env.acr -f docker/compose/nuxt-app.compose.yml up -d
#         （compose 的 ${} 插值只读 shell / --env-file，env_file 不参与插值；缺省会退化为 0.0.0.0）
# ====================================================================
# 阿里云 ACR 个人版仓库地址：从 ACR 控制台「仓库管理 → 访问凭证」页复制完整域名（新 crpi 格式，
# 形如 crpi-xxxxxxxx.cn-<地域>.personal.cr.aliyuncs.com；老 registry.cn-xxx.aliyuncs.com 已不通，勿手拼）
ACR_REGISTRY=""
# ACR 命名空间（镜像仓库前缀，如项目名；需先在控制台创建）
ACR_NAMESPACE=""
# ACR 登录用户名（个人版 = 访问凭证页的登录用户名，通常为阿里云账号/手机号）
ACR_USERNAME=""
# ACR 登录密码（个人版 = 访问凭证页设置的 Registry 登录密码，不是阿里云账号密码）
ACR_PASSWORD=""
# 镜像标签：与已 push 的 tag 一致才能拉到；留空 build-push.sh 默认取当天 UTC 时间戳
IMAGE_TAG=""
# ---- 多机部署网络变量（nuxt-app compose 端口绑定与 DB/Redis 接线用；缺省端口退化为 0.0.0.0）----
# 机器 A 内网 IP（运行 nginx + redis 6379）
NODE_A_IP=""
# 机器 B 内网 IP（运行 mariadb 3306）
NODE_B_IP=""
# 当前机器内网 IP（本机端口绑定地址；A 上填 A、B 上填 B）
NODE_LOCAL_IP=""
