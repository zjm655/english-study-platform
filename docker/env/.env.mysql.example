# ====================================================================
# MySQL 容器完整初始化配置（基础设施独立配置，不依赖 app 的 .env）
# 复制为 .env.mysql 后使用：cp .env.mysql.example .env.mysql
# 此文件入库为模板，.env.mysql 被 gitignore
#
# 设计理念：数据库是基础设施，先于 app 部署，配置自包含。
# app 部署时需将此处的 DATABASE/USER/PASSWORD 同步到根目录 .env 的
# NUXT_DB_DATABASE/NUXT_DB_USER/NUXT_DB_PASSWORD（app 适配数据库）。
#
# compose 中 env_file 注入后，MYSQL_* 变量直接被 mysql 镜像读取，
# 无需 ${} 插值；healthcheck 中的密码用 $$ 转义由容器内 shell 展开。
# ====================================================================

# MySQL root 密码（mysql 镜像管理员账号，首次启动初始化用，请用强密码）
MYSQL_ROOT_PASSWORD=change_me_root_password

# 业务数据库配置（mysql 镜像首次启动时自动创建数据库和用户）
MYSQL_DATABASE=nuxt4_demo
MYSQL_USER=nuxt_user
MYSQL_PASSWORD=change_me_password
