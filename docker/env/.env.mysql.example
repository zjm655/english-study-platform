# MySQL 容器初始化配置（基础设施独立配置，不依赖 app 的 .env）
# 复制方式：cp .env.mysql.example .env.mysql（此文件入库为模板，.env.mysql 被 gitignore）
# MYSQL_DATABASE/USER/PASSWORD 须与 .env.migrate 的 NUXT_DB_* 一致

# MySQL root 密码（管理员账号，首次启动初始化用，请用强密码）
MYSQL_ROOT_PASSWORD=change_me_root_password
# 业务数据库名（镜像首次启动自动创建）
MYSQL_DATABASE=nuxt4_demo
# 业务用户（镜像首次启动自动创建）
MYSQL_USER=nuxt_user
# 业务密码（请用强密码）
MYSQL_PASSWORD=change_me_password
