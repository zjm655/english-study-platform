# ====================================================================
# Docker 部署 migrate 服务专用配置（仅数据库迁移所需变量）
# 复制为 .env.migrate 后使用：cp .env.migrate.example .env.migrate
# 此文件入库为模板，.env.migrate 被 gitignore
#
# 设计理念：迁移只需 DB 连接信息，与 app 解耦（不需要 OSS/DeepSeek/NLS 等）。
# 三个含 migrate 服务的 compose 文件（docker-compose.yml/mysql.yml/dev.yml）
# 的 migrate 服务 env_file 均指向 docker/env/.env.migrate。
#
# 注意：NUXT_DB_HOST 在 compose 中通常被 environment 覆盖为容器间服务名（如 db）。
# ====================================================================

# 数据库连接配置（须与 .env.mysql 的 MYSQL_DATABASE/USER/PASSWORD 一致）
NUXT_DB_HOST=db
NUXT_DB_PORT=3306
NUXT_DB_USER=nuxt_user
NUXT_DB_PASSWORD=change_me_password
NUXT_DB_DATABASE=nuxt4_demo

# 迁移排序规则：MySQL 8.0+ 用默认 utf8mb4_0900_ai_ci；低版本(<8.0)改 utf8mb4_unicode_ci 或 utf8mb4_general_ci。
# 由 migrate.ts 在项目运行前直读（不走 Nuxt runtimeConfig），改 .env 即生效，无需构建。
NUXT_DB_COLLATION=utf8mb4_0900_ai_ci
