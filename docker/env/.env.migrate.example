# Docker migrate 服务专用配置：仅需 DB 连接信息，与 app 解耦
# 使用：cp .env.migrate.example .env.migrate（此文件为模板，.env.migrate 被 gitignore）
# 数据库连接配置（须与 .env.mysql 的 MYSQL_DATABASE/USER/PASSWORD 一致；NUXT_DB_HOST 在 compose 中常被覆盖为服务名 db）
# 数据库主机
NUXT_DB_HOST=db
# 数据库端口
NUXT_DB_PORT=3306
# 数据库用户
NUXT_DB_USER=nuxt_user
# 数据库密码
NUXT_DB_PASSWORD=change_me_password
# 数据库名
NUXT_DB_DATABASE=nuxt4_demo
# 迁移排序规则：MySQL 8.0+ 用默认 utf8mb4_0900_ai_ci；低版本(<8.0)改 utf8mb4_unicode_ci 或 utf8mb4_general_ci
NUXT_DB_COLLATION=utf8mb4_0900_ai_ci
