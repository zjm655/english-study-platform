# Redis 容器独立配置（基础设施独立 env 模式，由 docker compose 以 env_file 注入）
# 此文件入库为模板，.env.redis 被 gitignore；复制使用：cp .env.redis.example .env.redis
# 沿用独立 env 模式，与 .env.mysql 并列，敏感配置各自携带、不合并进 app 的 .env

# Redis 访问密码（唯一必填，请用强密码）：经 docker compose command 的
# --requirepass $$REDIS_PASSWORD 由容器内 shell 展开注入，不落 redis.conf、不入库、勿提交真实密码。
REDIS_PASSWORD=test123

# Redis 端口绑定地址（多机部署必填）：机器 A 内网 IP，仅内网监听（不暴露公网）。
# 单机本地验证可留空（''）或填 127.0.0.1；多机部署必须填机器 A 的内网 IP，供机器 B 的 nuxt 访问。
REDIS_BIND_IP=""

# 可选：Redis 内存上限
# 默认 256mb（已在 docker/redis/redis.conf 写死 maxmemory 256mb），
# 此处仅作说明性占位、不参与生效；如需覆盖可在 compose environment 传递。

#REDIS_MAXMEMORY=256mb
