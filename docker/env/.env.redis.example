# ====================================================================
# Redis 容器配置（基础设施独立配置）
# 复制为 .env.redis 后使用：cp .env.redis.example .env.redis
# 此文件入库为模板，.env.redis 被 gitignore
#
# 仅 docker-compose.redis.yml 多实例部署时使用（当前系统为单实例内存态）。
# compose 中 env_file 注入后，REDIS_PASSWORD 通过 $$ 转义由容器内 shell 展开。
# ====================================================================

# Redis 访问密码（请用强密码）
REDIS_PASSWORD=change_me_redis_password
