# ====================================================================
# Nginx 负载均衡配置示例（多实例部署场景）
# 启用方式：改名为 .conf 后缀（nginx 会自动 include）
#   mv upstream-balanced.conf.example upstream-balanced.conf
#   # 同时删除或注释 default.conf 的 upstream 块，避免重复定义 nuxt_app
#   docker compose -f docker/compose/docker-compose.nginx.yml restart
#
# 此配置假设多个 app 实例通过 docker compose up --scale app=N 启动，
# compose 会为同名服务分配 app_1/app_2/... 等容器名（或自定义命名）。
# 实际部署时请按真实容器名/IP 调整 server 列表。
# ====================================================================

upstream nuxt_app {
    # 多实例负载均衡（默认轮询策略）
    # 如需会话保持（黏性会话），加 ip_hash; 指令
    # 如需加权轮询，在 server 后加 weight=N
    server app1:3000;
    server app2:3000;
    server app3:3000;
}

server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://nuxt_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket 支持（评测 SDK 等可能用到）
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # 超时设置（评测/上传等长连接场景）
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
