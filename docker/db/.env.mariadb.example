# MariaDB 容器初始化配置（机器 B 独立数据库，基础设施独立，不依赖 app 的 .env）
# 复制方式：cp .env.mariadb.example .env.mariadb（本文件入库为模板，.env.mariadb 被 gitignore）
# MARIADB_DATABASE/USER/PASSWORD 须与 .env.migrate 的 NUXT_DB_* 一致
# 注意：NUXT_DB_COLLATION 须为 utf8mb4_unicode_ci（MariaDB 不支持 utf8mb4_0900_ai_ci）

# 端口绑定：宿主机全接口（3307），公网可达性由云防火墙/安全组控制（仅放行对端内网 IP 的 3307）
# MariaDB root 密码（管理员账号，首次启动初始化用，请用强密码）
MARIADB_ROOT_PASSWORD=
# 业务数据库名（镜像首次启动自动创建）
MARIADB_DATABASE=
# 业务用户（镜像首次启动自动创建）
MARIADB_USER=
# 业务密码（请用强密码）
MARIADB_PASSWORD=
