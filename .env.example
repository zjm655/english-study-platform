# AccessKey 密钥对
NUXT_OSS_ACCESS_KEY_ID=""
NUXT_OSS_ACCESS_KEY_SECRET=""
# 公网部署到阿里云 ECS 同 region 时设为 true，走内网免流量费
NUXT_OSS_USE_INTERNAL=""
# 阿里云oss流量是否走内网通道
NUXT_OSS_USE_INTERNAL=""

NUXT_DEEPSEEK_MODEL = ""
