NUXT_NLS_ACCESS_KEY_ID=""
NUXT_NLS_ACCESS_KEY_SECRET=""
# 智能语音交互服务网关地址（通用，自动就近分配）
NUXT_NLS_GATEWAY=""
NUXT_NLS_APP_KEY=""

# ============ Edge TTS 代理（可选，服务器公网 IP 被微软封锁时启用）============
# Cloudflare Worker 中转地址（部署代码见 content/cloudflare/tts-proxy-worker.js），
# 形如 wss://你的域名/tts；留空则直连微软（本地开发默认）
NUXT_TTS_PROXY_URL=""
# 代理校验密钥，必须与 Worker 的 Secret 变量 PROXY_KEY 完全一致（随机长字符串）
NUXT_TTS_PROXY_KEY=""

# 智能科教内容生成平台
NUXT_AI_CONTENT_APP_ID=""
NUXT_AI_CONTENT_APP_SECRET=""
NUXT_AI_CONTENT_ACCESS_KEY_ID=""
NUXT_AI_CONTENT_ACCESS_KEY_SECRET=""

# 云产品调用与账单查询
NUXT_BSS_ACCESS_KEY_ID=""
NUXT_BSS_ACCESS_KEY_SECRET=""

# ============ 启动期自举「全局唯一超级管理员」（可选功能）============
# 作用：服务启动时若配了下面的账号+密码，自动在数据库创建一个超级管理员（role=2）。
# 开关：ACCOUNT 与 PASSWORD 必须同时非空才启用；任一为空则整个功能跳过（不影响正常启动）。
# 幂等：每次启动都检查，已存在同账号的超管则直接跳过，不会重复创建。

# 超管登录账号（必填，≤20 字符，须唯一、不能与已有用户重复）
NUXT_SUPER_ADMIN_ACCOUNT=""
# 超管登录密码（必填，≥8 位）：此处填明文，启动时用 bcrypt 加密入库；切勿把真实密码提交进仓库，建议首登后改密
NUXT_SUPER_ADMIN_PASSWORD=""
# 超管昵称（选填，留空则默认用账号当昵称）
NUXT_SUPER_ADMIN_NICKNAME=""
# 超管邮箱（选填，留空则不设置）
NUXT_SUPER_ADMIN_EMAIL=""
# 危险开关（选填，仅当值精确为 true 或 1 时生效）：
#   当库中已存在「其它账号」的超管（如迁移 018 自动升级出来的那个）时，置 true 会把旧超管
#   降级为普通管理员、再用上面的账号立为新超管（该替换会记入审计日志）。
#   这是无头启动环境下的「二次确认」——不显式开启就只告警跳过、绝不擅自替换。
#   属一次性动作，替换完成后建议改回空，以免日后改了账号又重启时被误触发。
NUXT_SUPER_ADMIN_FORCE_REPLACE=false